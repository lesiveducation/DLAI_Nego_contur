---
const { name, role, experience, sectors, bio, image, alt } = Astro.props;
---
<article class="expert-card">
  <img src={image} alt={alt} width="1024" height="1280" loading="lazy" />
  <div class="expert-copy">
    <p class="experience">{experience}</p>
    <h3>{name}</h3>
    <p class="role">{role}</p>
    <p>{bio}</p>
    <p class="sectors">{sectors}</p>
  </div>
</article>

<style>
  .expert-card{background:var(--color-surface);border:1px solid var(--color-line)}
  img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:center top;filter:grayscale(1)}
  .expert-copy{padding:1.5rem}
  .experience{margin-bottom:1.2rem;color:var(--color-muted);font-size:.7rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  h3{margin-bottom:.35rem;font-size:1.55rem}
  .role{margin-bottom:1.25rem;font-weight:700}
  .expert-copy>p:not(.experience):not(.role):not(.sectors){color:var(--color-muted)}
  .sectors{margin:1.5rem 0 0;padding-top:1rem;border-top:1px solid var(--color-line);font-size:.78rem;font-weight:700}
</style>
