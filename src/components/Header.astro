---
const path = Astro.url.pathname;
const items = [['/','Главная'],['/services','Услуги'],['/experts','Эксперты'],['/ai-negotiator','Переговорный ИИ'],['/about','О компании'],['/cases','Кейсы'],['/blog','Блог'],['/faq','Частые вопросы'],['/contacts','Контакты']];
const active = (href) => href === '/' ? path === '/' : path.startsWith(href);
---
<header><div class="container bar"><a class="logo" href="/" aria-label="Контур переговоров — главная"><span>КП</span><b>Контур<br/>переговоров</b></a><details><summary>Меню</summary><nav>{items.map(([href,label]) => <a href={href} class:list={{active:active(href)}}>{label}</a>)}</nav></details><button class="theme-toggle" id="theme-toggle" type="button" aria-label="Переключить тему" onclick="window.toggleSiteTheme()"><span class="theme-glyph" aria-hidden="true">◐</span></button><a class="button appointment" href="#">Записаться на приём</a></div></header>
<style>header{position:sticky;top:0;z-index:20;background:var(--header-bg);backdrop-filter:blur(12px);border-bottom:1px solid var(--color-line)}.bar{height:78px;display:flex;align-items:center;gap:1.2rem}.logo{display:flex;align-items:center;gap:.7rem;text-decoration:none;margin-right:auto}.logo span{width:42px;height:42px;display:grid;place-items:center;background:var(--color-text);color:var(--color-bg);font-size:.76rem;font-weight:800;letter-spacing:.06em}.logo b{font-size:.78rem;line-height:1.05;text-transform:uppercase;letter-spacing:.05em}details{order:4}summary{display:block;cursor:pointer;font-weight:800;list-style:none;padding:.55rem 0}summary::-webkit-details-marker{display:none}nav{display:none;position:absolute;top:78px;left:0;right:0;grid-template-columns:repeat(7,auto);justify-content:center;gap:2rem;background:var(--color-surface);padding:1.25rem 2rem;border-bottom:1px solid var(--color-line);box-shadow:0 18px 35px rgba(0,0,0,.1)}details[open] nav{display:grid}nav a{text-decoration:none;color:var(--color-muted);font-size:.76rem;font-weight:700;padding:.45rem 0;border-bottom:2px solid transparent}nav a:hover,nav a.active{color:var(--color-text);border-color:var(--color-text)}.appointment{font-size:.78rem}.theme-toggle{width:38px;height:38px;border:1px solid #090909;border-radius:50%;background:#090909;color:#fff;cursor:pointer;display:grid;place-items:center;font-size:1rem;line-height:1;transition:.2s}.theme-toggle:hover{transform:translateY(-2px)}.theme-toggle .moon{display:none}[data-theme='dark'] .theme-toggle{background:#fff;color:#090909;border-color:#fff}[data-theme='dark'] .theme-toggle .sun{display:none}[data-theme='dark'] .theme-toggle .moon{display:inline}@media(max-width:900px){nav{grid-template-columns:1fr;justify-content:stretch;gap:.25rem;padding:1rem 2rem}.theme-toggle{margin-left:auto}.appointment{margin-left:0}}@media(max-width:580px){.appointment{display:none}}</style>
