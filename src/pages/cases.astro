---
import Layout from '../layouts/Layout.astro'; import PageHero from '../components/PageHero.astro'; import CaseCard from '../components/CaseCard.astro'; import Testimonial from '../components/Testimonial.astro'; import ContactForm from '../components/ContactForm.astro'; import { cases } from '../data.js';
---
<Layout title="Кейсы — Контур переговоров" description="Примеры обучения команд продаж и сопровождения сложных B2B-переговоров."><PageHero label="Кейсы" title="Меняем поведение — улучшаем экономику сделки" lead="Примеры задач, где системная подготовка дала измеримый коммерческий результат."/><section class="section"><div class="container grid-3">{cases.map(item => <CaseCard {...item}/>)}</div></section><section class="section"><div class="container"><Testimonial quote="На финальной встрече мы спокойно удержали условия, которые раньше сами бы предложили смягчить. Контракт подписали в нашем диапазоне." name="Илья Ветров" role="Директор по продажам, производство"/></div></section><section class="section"><div class="container"><ContactForm/></div></section></Layout>
