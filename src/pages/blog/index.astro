---
import Layout from '../../layouts/Layout.astro'; import PageHero from '../../components/PageHero.astro'; import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Layout title="Блог — Контур переговоров" description="Практические статьи о подготовке, аргументации и управлении сложными переговорами."><PageHero label="Блог" title="Переговоры без магии" lead="Наблюдения и рабочие инструменты для руководителей и команд продаж."/><section class="section"><div class="container posts">{posts.map((post,index)=><article><span>0{index+1}</span><div><small>{post.data.pubDate.toLocaleDateString('ru-RU')} · {post.data.readTime}</small><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="read" href={`/blog/${post.id}`}>Читать →</a></div></article>)}</div></section></Layout>
<style>.posts{border:1px solid var(--color-line)}article{background:var(--color-surface);padding:clamp(1.5rem,4vw,3rem);display:grid;grid-template-columns:auto 1fr;gap:2rem;border-bottom:1px solid var(--color-line)}article:last-child{border-bottom:0}article>span{color:var(--color-primary);font-weight:800}small{color:var(--color-muted)}h2{font-size:clamp(1.7rem,3vw,2.8rem);margin:.7rem 0}h2 a{text-decoration:none}p{color:var(--color-muted);max-width:720px}.read{color:var(--color-primary);font-weight:800}</style>
