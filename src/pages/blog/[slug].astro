---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const posts = await getCollection('blog'); return posts.map(post => ({ params: { slug: post.id }, props: post })); }
const post = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — КП`} description={post.data.description}><section class="page-intro" style="--page-bg:url('/negotiation-boardroom.png')"><div class="container article-head"><div class="crumbs"><a href="/">Главная</a> / <a href="/blog">Блог</a> / Статья</div><span class="kicker">Практика</span><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><small>{post.data.pubDate.toLocaleDateString('ru-RU')} · {post.data.readTime}</small></div></section><section class="section"><article class="container prose"><Content/><p class="back"><a href="/blog">← Вернуться в блог</a></p></article></section></Layout>
<style>.article-head{max-width:980px}.article-head h1{font-size:clamp(2.4rem,5vw,5rem)}small{color:#c4ced7}.back{margin-top:4rem;padding-top:2rem;border-top:1px solid var(--color-line)}</style>
