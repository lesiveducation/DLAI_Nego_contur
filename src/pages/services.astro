---
import Layout from '../layouts/Layout.astro'; import PageHero from '../components/PageHero.astro'; import ServiceCard from '../components/ServiceCard.astro'; import ContactForm from '../components/ContactForm.astro'; import { services } from '../data.js';
---
<Layout title="Услуги — Контур переговоров" description="Корпоративное обучение, аудит, переговорные спарринги и аутсорс сложных переговоров."><PageHero label="Услуги" title="Работаем и с навыком, и с результатом сделки" lead="Выберите отдельный формат или соберите программу под задачу отдела продаж."/><section class="section"><div class="container grid-3">{services.map(service => <ServiceCard {...service}/>)}</div></section><section class="section ai-section"><div class="container ai-grid"><div><span class="kicker">Переговорный ИИ</span><h2>Сценарий, который знает ваш контекст</h2><p class="lead">Подключаем ИИ-бота к разрешённым источникам компании. Он в реальном времени собирает внутреннюю аналитику и открытые публикации о партнёрах, а затем формирует переговорные сценарии для конкретных встреч.</p><p>Команда тренируется на этих сценариях до реального разговора: бот меняет позицию второй стороны, проверяет аргументы и помогает увидеть риски. Эксперт настраивает логику тренировки и разбирает решения участников.</p></div><ol><li><b>01</b><span><strong>Собирает контекст</strong>CRM, отчёты, история сделок и разрешённые публичные источники.</span></li><li><b>02</b><span><strong>Строит сценарии</strong>Интересы сторон, аргументы, диапазоны и сложные повороты разговора.</span></li><li><b>03</b><span><strong>Тренирует команду</strong>Ролевые диалоги, обратная связь и повторная практика.</span></li></ol></div><div class="container ai-note">Доступы, перечень источников и правила хранения данных согласуются с заказчиком до подключения.</div></section><section class="section"><div class="container stats"><div class="stat"><strong>80%</strong>практики</div><div class="stat"><strong>1–2</strong>дня интенсив</div><div class="stat"><strong>4–6</strong>недель цикл</div><div class="stat"><strong>1:1</strong>спарринг</div></div></section><section class="section"><div class="container"><ContactForm/></div></section></Layout>
<style>.ai-section{background:#050505;color:#fff}.ai-section .kicker{color:#fff}.ai-section .lead,.ai-section p{color:#bbb}.ai-grid{display:grid;gap:4rem}.ai-grid h2{max-width:760px;margin-bottom:1.75rem}.ai-grid ol{margin:0;padding:0;list-style:none;border-top:1px solid #333}.ai-grid li{display:grid;grid-template-columns:54px 1fr;gap:1rem;padding:1.4rem 0;border-bottom:1px solid #333}.ai-grid li>b{font-size:.75rem;color:#aaa}.ai-grid li strong{display:block;margin-bottom:.3rem}.ai-grid li span{color:#aaa}.ai-note{margin-top:2rem;color:#888;font-size:.75rem}@media(min-width:900px){.ai-grid{grid-template-columns:1.15fr .85fr;align-items:start}}</style>
