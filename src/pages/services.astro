---
import Layout from '../layouts/Layout.astro'; import PageHero from '../components/PageHero.astro'; import ServiceCard from '../components/ServiceCard.astro'; import ContactForm from '../components/ContactForm.astro'; import { services } from '../data.js';
---
<Layout title="Услуги — Контур переговоров" description="Корпоративное обучение, аудит, переговорные спарринги и аутсорс сложных переговоров."><PageHero label="Услуги" title="Работаем и с навыком, и с результатом сделки" lead="Выберите отдельный формат или соберите программу под задачу отдела продаж."/><section class="section"><div class="container grid-3">{services.map(service => <ServiceCard {...service}/>)}</div></section><section class="section"><div class="container stats"><div class="stat"><strong>80%</strong>практики</div><div class="stat"><strong>1–2</strong>дня интенсив</div><div class="stat"><strong>4–6</strong>недель цикл</div><div class="stat"><strong>1:1</strong>спарринг</div></div></section><section class="section"><div class="container"><ContactForm/></div></section></Layout>
